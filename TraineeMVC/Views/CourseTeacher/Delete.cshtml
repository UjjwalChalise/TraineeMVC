@model CourseTeacher

<h1>Remove Teacher Assignment</h1>

<h3>Are you sure you want to remove this assignment?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-3">Course</dt>
        <dd class="col-sm-9">@Model.Course.Title</dd>

        <dt class="col-sm-3">Teacher</dt>
        <dd class="col-sm-9">@Model.Teacher.UserDetails.FirstName @Model.Teacher.UserDetails.LastName</dd>

        <dt class="col-sm-3">Primary Teacher</dt>
        <dd class="col-sm-9">@(Model.IsPrimaryTeacher ? "Yes" : "No")</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="CourseId" />
        <input type="hidden" asp-for="TeacherId" />
        <button type="submit" class="btn btn-danger">Remove</button>
        <a asp-action="Index">Back to List</a>
    </form>
</div>