@model IEnumerable<CourseTeacher>

<h1>Course Teacher Assignments</h1>

<p>
    <a asp-action="Create">Assign Teacher to Course</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Course</th>
            <th>Teacher</th>
            <th>Primary Teacher</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Course.Title</td>
                <td>@item.Teacher.UserDetails.FirstName @item.Teacher.UserDetails.LastName</td>
                <td>@(item.IsPrimaryTeacher ? "Yes" : "No")</td>
                <td>
                    <a asp-action="Delete"
                       asp-route-courseId="@item.CourseId"
                       asp-route-teacherId="@item.TeacherId">Remove</a>
                </td>
            </tr>
        }
    </tbody>
</table>