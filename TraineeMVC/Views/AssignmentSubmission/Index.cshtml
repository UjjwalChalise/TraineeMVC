@model IEnumerable<TraineeMVC.Models.AssignmentSubmission>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.AssignmentId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Assignment)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StudentId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Student)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SubmittedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FilePath)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Content)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Grade)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Feedback)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.AssignmentId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Assignment)
            </td>
            <td>
                @Html.DisplayFor(model => item.StudentId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Student)
            </td>
            <td>
                @Html.DisplayFor(model => item.SubmittedAt)
            </td>
            <td>
                @Html.DisplayFor(model => item.FilePath)
            </td>
            <td>
                @Html.DisplayFor(model => item.Content)
            </td>
            <td>
                @Html.DisplayFor(model => item.Grade)
            </td>
            <td>
                @Html.DisplayFor(model => item.Feedback)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
