@model TraineeMVC.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h2>Welcome to LMS Dashboard </h2>
<p class="text-muted">Manage Students, Teachers, Courses and Attendance.</p>

<div class="row g-4 mt-2">
    <div class="col-md-4">
        <div class="dash-card card-navy">
            <div><i class="fa-solid fa-users"></i> Students</div>
            <h1>@Model.TotalStudents</h1>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dash-card card-slate">
            <div><i class="fa-solid fa-chalkboard-user"></i> Teachers</div>
            <h1>@Model.TotalTeachers</h1>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dash-card card-navy">
            <div><i class="fa-solid fa-book"></i> Courses</div>
            <h1>@Model.TotalCourses</h1>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dash-card card-slate">
            <div><i class="fa-solid fa-layer-group"></i> Modules</div>
            <h1>@Model.TotalModules</h1>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dash-card card-navy">
            <div><i class="fa-solid fa-file-lines"></i> Tasks</div>
            <h1>@Model.TotalTasks</h1>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dash-card card-slate">
            <div><i class="fa-solid fa-calendar-check"></i> Attendance</div>
            <h1>@Model.TotalAttendance</h1>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dash-card card-navy">
            <div><i class="fa-solid fa-clipboard-list"></i> Assignments</div>
            <h1>@Model.TotalAssignments</h1>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dash-card card-slate">
            <div><i class="fa-solid fa-user"></i> Users</div>
            <h1>@Model.TotalUsers</h1>
        </div>
    </div>
</div>