<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LMS Portal</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body>

    <div class="d-flex">

        <!-- Sidebar -->
        <div class="sidebar">

            <div class="logo">
                <h3>
                    <i class="fas fa-graduation-cap"></i>
                    LMS Portal
                </h3>
            </div>

            <ul class="nav flex-column mt-4">

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-chart-line"></i> Dashboard
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Student" asp-action="Index">
                        <i class="fas fa-user-graduate"></i> Students
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Teacher" asp-action="Index">
                        <i class="fas fa-chalkboard-teacher"></i> Teachers
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Course" asp-action="Index">
                        <i class="fas fa-book"></i> Courses
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Module" asp-action="Index">
                        <i class="fas fa-layer-group"></i> Modules
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Assignment" asp-action="Index">
                        <i class="fas fa-file-alt"></i> Assignments
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Attendance" asp-action="Index">
                        <i class="fas fa-calendar-check"></i> Attendance
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="User" asp-action="Index">
                        <i class="fas fa-user"></i> User Details
                    </a>
                </li>

            </ul>

        </div>

        <!-- Main Content -->
        <div class="main-content w-100">

            <nav class="navbar navbar-expand navbar-light bg-white shadow-sm px-4">

                <span class="navbar-brand fw-bold">
                    Learning Management System
                </span>

                <div class="ms-auto">

                    <a asp-controller="User"
                       asp-action="Login"
                       class="btn btn-outline-primary me-2">
                        <i class="fas fa-sign-in-alt"></i> Login
                    </a>

                    <a asp-controller="User"
                       asp-action="Logout"
                       class="btn btn-danger">
                        <i class="fas fa-sign-out-alt"></i> Logout
                    </a>

                </div>

            </nav>

            <main class="p-4">
                @RenderBody()
            </main>

        </div>

    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    ~/lib/bootstrap/dist/js/bootstrap.bundle.min.jsscript>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>