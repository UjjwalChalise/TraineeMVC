<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - TraineeMVC</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />


    <link rel="stylesheet" href="~/css/lms-layout.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/TraineeMVC.styles.css" asp-append-version="true" />
</head>

<body>
    <header class="lms-header">

        <nav class="navbar navbar-expand lms-navbar">

            <div class="container-fluid">

                <a class="navbar-brand lms-brand"
                   asp-area=""
                   asp-controller="Dashboard"
                   asp-action="Index">

                    <span class="brand-icon">
                        <i class="bi bi-mortarboard-fill"></i>
                    </span>

                    <span class="brand-text">
                        Trainee <strong>LMS</strong>
                    </span>

                </a>

                <!-- for login and logout-->

    @*             <div class="navbar-nav ms-auto lms-user-nav">

                    <a class="nav-link lms-nav-link"
                       asp-area=""
                       asp-controller="Account"
                       asp-action="Login">

                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Login</span>

                    </a>

                    <a class="nav-link lms-nav-link logout-link"
                       asp-area=""
                       asp-controller="Account"
                       asp-action="Logout">

                        <i class="bi bi-box-arrow-right"></i>
                        <span>Logout</span>

                    </a>
                </div>
            </div>
        </nav>
    </header> *@
              <div class="navbar-nav ms-auto lms-user-nav">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="d-inline">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="nav-link lms-nav-link logout-link border-0 bg-transparent">

                                <i class="bi bi-box-arrow-right"></i>

                                <span>Logout</span>

                            </button>

                        </form>
                    }
                    else
                    {
                        <a class="nav-link lms-nav-link"
                           asp-controller="Account"
                           asp-action="Login">

                            <i class="bi bi-box-arrow-in-right"></i>

                            <span>Login</span>

                        </a>
                    }
                </div>
            </div>
        </nav>
    </header>



    <div class="lms-wrapper">
        <aside class="lms-sidebar" id="lmsSidebar">

            <div class="sidebar-header">

                <button type="button"
                        class="sidebar-toggle"
                        id="sidebarToggle"
                        aria-label="Toggle sidebar"
                        title="Toggle sidebar">

                    <i class="bi bi-list"></i>

                </button>

                <span class="sidebar-title">
                    Navigation
                </span>

            </div>


            <nav class="sidebar-nav">

                <div class="sidebar-section-title">
                    Main Menu
                </div>

                <a class="sidebar-link"
                   asp-area=""
                   asp-controller="Dashboard"
                   asp-action="Index"
                   title="Dashboard">

                    <span class="sidebar-icon">
                        <i class="bi bi-grid-1x2-fill"></i>
                    </span>

                    <span class="sidebar-text">
                        Dashboard
                    </span>

                </a>

                <a class="sidebar-link"
                   asp-area=""
                   asp-controller="UserDetails"
                   asp-action="Index"
                   title="User Details">

                    <span class="sidebar-icon">
                        <i class="bi bi-person-circle"></i>
                    </span>

                    <span class="sidebar-text">
                        User Details
                    </span>

                </a>

                <a class="sidebar-link"
                   asp-area=""
                   asp-controller="Modules"
                   asp-action="Index"
                   title="Modules">

                    <span class="sidebar-icon">
                        <i class="bi bi-book"></i>
                    </span>

                    <span class="sidebar-text">
                        Modules
                    </span>

                </a>

                <a class="sidebar-link"
                   asp-area=""
                   asp-controller="Courses"
                   asp-action="Index"
                   title="Courses">

                    <span class="sidebar-icon">
                        <i class="bi bi-mortarboard"></i>
                    </span>

                    <span class="sidebar-text">
                        Courses
                    </span>

                </a>

                <a class="sidebar-link"
                   asp-area=""
                   asp-controller="Assignments"
                   asp-action="Index"
                   title="Assignments">

                    <span class="sidebar-icon">
                        <i class="bi bi-clipboard-check"></i>
                    </span>

                    <span class="sidebar-text">
                        Assignments
                    </span>

                </a>


                <div class="sidebar-section-title sidebar-section-spaced">
                    Management
                </div>


                <a class="sidebar-link"
                   asp-area=""
                   asp-controller="Students"
                   asp-action="Index"
                   title="Students">

                    <span class="sidebar-icon">
                        <i class="bi bi-people-fill"></i>
                    </span>

                    <span class="sidebar-text">
                        Students
                    </span>

                </a>


                <a class="sidebar-link"
                   asp-area=""
                   asp-controller="Teachers"
                   asp-action="Index"
                   title="Teachers">

                    <span class="sidebar-icon">
                        <i class="bi bi-person-workspace"></i>
                    </span>

                    <span class="sidebar-text">
                        Teachers
                    </span>

                </a>

                <a class="sidebar-link"
                   asp-area=""
                   asp-controller="Attendances"
                   asp-action="Index"
                   title="Attendance">

                    <span class="sidebar-icon">
                        <i class="bi bi-calendar-check"></i>
                    </span>

                    <span class="sidebar-text">
                        Attendance
                    </span>

                </a>

            </nav>

        </aside>

        <main class="lms-main">

            <div class="lms-content">

                @RenderBody()

            </div>

        </main>

    </div>


    <footer class="lms-footer">

        <div class="container-fluid">

            <span>
                &copy; @DateTime.Now.Year Trainee LMS
            </span>

            <span class="footer-separator">•</span>

            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">

                Privacy
            </a>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>


    <script>

            document.addEventListener("DOMContentLoaded", function() {

                const sidebar = document.getElementById("lmsSidebar");
                const toggleButton = document.getElementById("sidebarToggle");

                if (toggleButton && sidebar) {

                    toggleButton.addEventListener("click", function() {

                        sidebar.classList.toggle("collapsed");

                    });

                }

            });

    </script>


    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
