<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - TraineeMVC</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/TraineeMVC.styles.css"
          asp-append-version="true" />
<style>
     .sidebar {
    position: fixed;
    top: 56px;
    left: -260px;
    width: 260px;
    height: calc(100vh - 56px);

    background-color: #5684AE;

    z-index: 1000;

    transition: left 0.3s ease;

    box-shadow: 2px 0 8px rgba(0, 0, 0, 0.2);
}

.sidebar.sidebar-open {
    left: 0;
}

.sidebar-header {
    padding: 20px;
    color: white;
    border-bottom: 1px solid #495057;
}

.sidebar-menu {
    list-style: none;
    padding: 0;
    margin: 0;
}

.sidebar-menu li a {
    display: block;
    padding: 15px 20px;

    color: white;
    text-decoration: none;
}

.sidebar-menu li a:hover {
    background-color: #495057;
}
     
    </style>

</head>


<body>

    <!-- ================= NAVBAR ================= -->

    <header>

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow">

            <div class="container-fluid">

                <!-- SIDEBAR TOGGLE BUTTON -->

                <button id="sidebarToggle"
                        class="btn btn-outline-secondary me-3"
                        type="button" onclick="toggleSidebar()">

                    ☰

                </button>


                <!-- BRAND -->

                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    TraineeMVC

                </a>


                <!-- MOBILE NAVBAR BUTTON -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- NAVIGATION -->

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Privacy">

                                Privacy

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Courses"
                               asp-action="Index">

                                Courses

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Users"
                               asp-action="Index">

                                Users

                            </a>

                        </li>

                    </ul>


                    <!-- LOGIN / LOGOUT -->
                    <!-- LOGIN / LOGOUT -->
                    <ul class="navbar-nav">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-dark">
                                    Hello, @User.Identity.Name!
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="form-inline">
                                    <button type="submit" class="nav-link btn btn-link">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>

            </div>

        </nav>

    </header>



    <!-- ================= SIDEBAR ================= -->

    <aside id="sidebar"
           class="sidebar">


        <ul class="sidebar-menu">

            <li>

                <a asp-controller="Users"
                   asp-action="Index">

                    <span>Users</span>

                </a>

            </li>

            <li>

                <a asp-controller="Courses"
                   asp-action="Index">
                    <span>Courses</span>

                </a>

            </li>


            <li>

                <a asp-controller="Assignments"
                   asp-action="Index">

     
                    <span>Assignments</span>

                </a>

            </li>


            <li>

                <a asp-controller="Teacher"
                   asp-action="Index">

            
                    <span>Teachers</span>

                </a>

            </li>


          
            <li>

                <a asp-controller="Student"
                   asp-action="Index">

            
                    <span>Student</span>

                </a>

            </li>
            <li>

                <a asp-controller="Module"
                   asp-action="Index">

            
                    <span>Module</span>

                </a>

            </li>
            <li>

                <a asp-controller="Attendance"
                   asp-action="Index">

            
                    <span>Attendance</span>

                </a>

            </li>
            <li>

                <a asp-controller="Enrollment"
                   asp-action="Index">

            
                    <span>Enrollment</span>

                </a>

            </li>
            


     

        </ul>

    </aside>



    <!-- ================= MAIN CONTENT ================= -->

    <div id="mainContent"
         class="main-content">

        <main role="main"
              class="pb-3">

            @RenderBody()

        </main>

    </div>



    <!-- ================= FOOTER ================= -->

    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; 2026 - TraineeMVC -

            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">

                Privacy

            </a>

        </div>

    </footer>



    <!-- ================= SCRIPTS ================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    <!-- SIDEBAR TOGGLE -->

    <script>

            const sidebarToggle =
                document.getElementById("sidebarToggle");

            const sidebar =
                document.getElementById("sidebar");

            const mainContent =
                document.getElementById("mainContent");


            sidebarToggle.addEventListener("click", function() {

                sidebar.classList.toggle("sidebar-open");

                mainContent.classList.toggle("content-shift");

            });

    </script>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
