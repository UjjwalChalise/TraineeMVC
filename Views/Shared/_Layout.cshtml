<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Trainee LMS</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/TraineeMVC.styles.css"
          asp-append-version="true" />

</head>

<body>

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">

            <div class="container-fluid px-4">

                <a class="navbar-brand d-flex align-items-center"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <i class="bi bi-mortarboard-fill me-2"></i>

                    <span class="fw-bold">
                        Trainee LMS
                    </span>

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">

                                <i class="bi bi-house-door me-1"></i>

                                Home

                            </a>

                        </li>

                    </ul>

                    <div class="navbar-account">

                        <a asp-controller="Home"
                           asp-action="Notifications"
                           class="nav-icon-link"
                           title="Notifications">

                            <i class="bi bi-bell"></i>

                        </a>

                        <span class="navbar-divider"></span>

                        <div class="d-flex gap-2">

                        <a asp-controller="Account"
                            asp-action="Register"
                            class="btn btn-outline-light btn-sm account-button">

                            <i class="bi bi-person-plus me-1"></i>

                            Sign Up

                        </a>

                        <a asp-controller="Account"
                            asp-action="Login"
                            class="btn btn-outline-light btn-sm account-button">

                            <i class="bi bi-box-arrow-in-right me-1"></i>

                            Login

                        </a>


                    </div>

                </div>

            </div>

        </nav>

    </header>

    <div class="container-fluid">

        <div class="row">

           <aside class="col-md-3 col-lg-2 sidebar">

    <div class="sidebar-content">

        <div class="sidebar-title">
            LMS MENU
        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="sidebar-link">

            <i class="bi bi-grid-1x2-fill"></i>
            <span>Dashboard</span>

        </a>

        <hr class="sidebar-divider" />

        <a asp-controller="Modules"
           asp-action="Index"
           class="sidebar-link">

            <i class="bi bi-collection-fill"></i>
            <span>Modules</span>

        </a>

        <a asp-controller="Courses"
           asp-action="Index"
           class="sidebar-link">

            <i class="bi bi-book-fill"></i>
            <span>Courses</span>

        </a>

        <a asp-controller="Assignments"
           asp-action="Index"
           class="sidebar-link">

            <i class="bi bi-journal-check"></i>
            <span>Assignments</span>

        </a>

        <a asp-controller="Attendances"
           asp-action="Index"
           class="sidebar-link">

            <i class="bi bi-calendar-check-fill"></i>
            <span>Attendance</span>

        </a>

        <a asp-controller="Students"
           asp-action="Index"
           class="sidebar-link">

            <i class="bi bi-person-vcard-fill"></i>
            <span>Students</span>

        </a>

        <a asp-controller="Teachers"
           asp-action="Index"
           class="sidebar-link">

            <i class="bi bi-person-workspace"></i>
            <span>Teachers</span>

        </a>

        <a asp-controller="Enrollments"
           asp-action="Index"
           class="sidebar-link">

            <i class="bi bi-card-checklist"></i>
            <span>Enrollments</span>

        </a>

    </div>

</aside>

            <main class="col-md-9 col-lg-10 main-content">

                @RenderBody()

            </main>

        </div>

    </div>

    <footer class="site-footer bg-dark text-white">

        <div class="container-fluid px-4 py-3">

            <div class="row align-items-center">

                <div class="col-md-6">

                    <span class="text-secondary">
                        © 2026 Trainee LMS
                    </span>

                </div>

                <div class="col-md-6 text-md-end">

                    <a asp-controller="Home"
                       asp-action="Privacy"
                       class="footer-link me-3">

                        Privacy

                    </a>

                    <a asp-controller="Home"
                       asp-action="Help"
                       class="footer-link">

                        Help

                    </a>

                </div>

            </div>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>

